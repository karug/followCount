# YouTube Data API v3 (required for youtube channels)
YOUTUBE_API_KEY=

# GitHub personal access token (optional, raises rate limits)
GITHUB_TOKEN=

# Twitch application credentials (required for twitch channels)
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# X API v2 bearer token (required for x channels)
# https://developer.x.com
X_BEARER_TOKEN=

# Facebook Graph API access token (optional: without it the public
# embed widget is scraped, which rounds big counts, e.g. "154M").
# Only needed if it must differ from INSTAGRAM_ACCESS_TOKEN below —
# the same token already covers Facebook Page reads.
# https://developers.facebook.com
FACEBOOK_ACCESS_TOKEN=

# Instagram Graph API long-lived token (optional but recommended:
# exact counts, no scraping/blocks). Permissions: pages_show_list,
# instagram_basic; plus instagram_manage_insights for accounts not
# linked to one of your pages (business discovery). Also used as
# the Facebook token when FACEBOOK_ACCESS_TOKEN is unset. Without
# it, public endpoints are scraped.
INSTAGRAM_ACCESS_TOKEN=

# App ID/Secret (Meta app > Settings > Basic). Optional, but without
# them INSTAGRAM_ACCESS_TOKEN cannot auto-refresh and will need to
# be regenerated by hand every ~60 days (see README).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Server port (default 3000)
# PORT=3000
